<Window x:Class="Seigetsu.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="霽月 - Seigetsu"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource AppFont}"
        Loaded="OnLoaded" MouseLeftButtonDown="OnSkip" KeyDown="OnSkip">
    <!--
      初回の起動アニメーション（画面全体）。夜空が広がり、いろいろな図形が集まって満月になり、
      右上から欠けて三日月になって、名前が浮かび上がる。外観の設定にかかわらず、夜空の黒と藍色で出す。
      図形や光は数が多いので、コードの側で作って動かす。
    -->
    <Grid x:Name="Root">
        <Rectangle x:Name="Sky" Opacity="0">
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.8" RadiusY="0.9">
                    <GradientStop Offset="0" Color="#171B47" />
                    <GradientStop Offset="0.45" Color="#0A0B1E" />
                    <GradientStop Offset="1" Color="#000000" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 星・光・図形・月を置く舞台 -->
        <Canvas x:Name="Stage" />

        <TextBlock x:Name="SkipHint" Text="クリックかキーで飛ばせます" FontSize="13" Foreground="#7D8391"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,36" Opacity="0" />
    </Grid>
</Window>
