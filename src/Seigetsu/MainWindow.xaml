<ui:FluentWindow x:Class="Seigetsu.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="霽月 - Seigetsu"
                 Width="1280" Height="820" MinWidth="1100" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource BgBrush}"
                 FontFamily="{StaticResource AppFont}"
                 Icon="pack://application:,,,/Assets/seigetsu.ico"
                 AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
                 PreviewKeyDown="OnPreviewKeyDown">

    <ui:FluentWindow.Resources>
        <!-- 左メニューの 1 項目 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="14,10">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2"
                                        Margin="-10,0,0,0" HorizontalAlignment="Left"
                                        Background="{StaticResource MoonBrush}" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarActiveBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- WPF-UI が窓の背景を上書きするので、霽月の背景色は中身の側で塗る -->
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左メニュー -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="14,44,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,26">
                    <ui:SymbolIcon Symbol="WeatherMoon24" Filled="True" FontSize="32"
                                   Foreground="{StaticResource MoonBrush}" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="霽 月" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MoonBrush}" />
                        <TextBlock Text="SEIGETSU" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource SidebarMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="10,0,0,0"
                           FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" />

                <!-- 小さなタイマー。どの画面からでも開始・一時停止でき、時間を押すとタイマー画面へ移る -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarActiveBrush}" CornerRadius="12"
                        Margin="0,0,0,12" Padding="14,8,6,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 再生中の BGM（押すと BGM 画面へ） -->
                        <TextBlock x:Name="MiniMusic" Grid.Row="1" Grid.ColumnSpan="2" FontSize="11" Margin="0,2,8,0"
                                   Foreground="{StaticResource SidebarMutedBrush}" TextTrimming="CharacterEllipsis"
                                   Cursor="Hand" Visibility="Collapsed" ToolTip="BGM 画面を開く"
                                   MouseLeftButtonUp="OnMiniMusicClick" />
                        <StackPanel Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnMiniTimerClick"
                                    ToolTip="タイマー画面を開く">
                            <TextBlock x:Name="MiniStatus" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MiniTime" FontSize="20" FontWeight="Bold" Foreground="White"
                                       FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Transparent" BorderThickness="0" Padding="8"
                                   VerticalAlignment="Center" Cursor="Hand" Click="OnMiniToggleClick"
                                   ToolTip="開始・一時停止" AutomationProperties.Name="タイマーの開始・一時停止">
                            <ui:SymbolIcon x:Name="MiniIcon" Symbol="Play24" Filled="True" FontSize="20"
                                           Foreground="White" />
                        </ui:Button>
                    </Grid>
                </Border>

                <ListBox x:Name="NavList"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnNavSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Label}" Margin="12,0,0,0" FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 画面の中身 -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="36,48,36,28" Focusable="False" />

        <!-- 画面の下に出る小さなお知らせ（v6 の Toast の代わり） -->
        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Column="1" VerticalAlignment="Bottom"
                              MaxWidth="560" Margin="0,0,0,24" Panel.ZIndex="5" />

        <!-- タイトルバー（最小化・最大化・閉じる）。左メニューの上もつかんで動かせる -->
        <ui:TitleBar Grid.ColumnSpan="2" VerticalAlignment="Top" Title="" Panel.ZIndex="10" />
    </Grid>
</ui:FluentWindow>
