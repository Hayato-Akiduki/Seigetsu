<Window x:Class="Seigetsu.DesktopStickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" MinWidth="180" MinHeight="110"
        FontFamily="{StaticResource AppFont}"
        SourceInitialized="OnSourceInitialized"
        LocationChanged="OnBoundsChanged" SizeChanged="OnBoundsChanged">
    <!-- 枠もタイトルバーもない、付箋だけの窓。ふちをつかむと大きさを変えられる -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderThickness="1">
        <DockPanel>
            <!-- 上の帯。ここをつかんで動かす。ダブルクリックで編集 -->
            <Grid DockPanel.Dock="Top" Background="Transparent" Cursor="SizeAll"
                  MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold" Margin="12,8,4,4"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2,2,0" Cursor="Arrow">
                    <ui:Button x:Name="PinButton" Style="{StaticResource IconButton}" Padding="5" Margin="0"
                               Click="OnPinClick">
                        <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" FontSize="14"
                                       Foreground="{DynamicResource MutedBrush}" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource IconButton}" Padding="5" Margin="0" Click="OnEditClick"
                               ToolTip="編集" AutomationProperties.Name="付箋を編集">
                        <ui:SymbolIcon Symbol="Edit24" FontSize="14" Foreground="{DynamicResource MutedBrush}" />
                    </ui:Button>
                    <ui:Button x:Name="CloseButton" Style="{StaticResource IconButton}" Padding="5" Margin="0" Click="OnCloseClick"
                               ToolTip="デスクトップから外す（付箋は残ります）"
                               AutomationProperties.Name="デスクトップから外す">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource MutedBrush}" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,2,4,10">
                <TextBlock x:Name="BodyText" FontSize="13" TextWrapping="Wrap" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextBrush}" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
