<ui:FluentWindow x:Class="Seigetsu.Dialogs.StickyDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="480" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
                 FontFamily="{StaticResource AppFont}"
                 Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
    <ui:FluentWindow.Resources>
        <!-- 色を選ぶ丸。選んでいる色には、まわりに青い輪とチェックが付く -->
        <Style x:Key="ColorSwatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5"
                                     Visibility="Hidden" />
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}"
                                     Stroke="{DynamicResource LineBrush}" StrokeThickness="1" />
                            <ui:SymbolIcon x:Name="Check" Symbol="Checkmark24" FontSize="14"
                                           Foreground="{DynamicResource TextBrush}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="28,0,28,24">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18" />

            <TextBlock Text="タイトル" Style="{StaticResource FieldLabel}" />
            <ui:TextBox x:Name="TitleBox" PlaceholderText="付箋" Margin="0,0,0,16" />

            <TextBlock Text="内容" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" Height="180"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     AutomationProperties.Name="付箋の内容" />

            <TextBlock Text="色" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
            <StackPanel x:Name="ColorPanel" Orientation="Horizontal" />

            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                       Margin="0,6,0,0" MinHeight="16" />

            <Grid Margin="0,10,0,0">
                <TextBlock Text="Ctrl+Enter で保存" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="キャンセル" IsCancel="True" Padding="18,8" Margin="0,0,8,0" />
                    <ui:Button x:Name="SaveButton" Appearance="Primary" Padding="22,8" Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
