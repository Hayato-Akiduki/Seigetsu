<Application x:Class="Seigetsu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 左メニューの色。外観に合わせて ThemeService が差し替える -->
            <SolidColorBrush x:Key="SidebarBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="SidebarLineBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="SidebarTextBrush" Color="#3C4150" />
            <SolidColorBrush x:Key="SidebarMutedBrush" Color="#8A90A0" />
            <SolidColorBrush x:Key="SidebarStrongBrush" Color="#17191F" />
            <SolidColorBrush x:Key="SidebarActiveBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#ECEEF2" />
            <SolidColorBrush x:Key="MoonBrush" Color="#3451D1" />

            <!-- 外観で変わる色。ThemeService が明るい／暗いに合わせて差し替える -->
            <SolidColorBrush x:Key="BgBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LineBrush" Color="#ECEEF1" />
            <SolidColorBrush x:Key="TextBrush" Color="#17191F" />
            <SolidColorBrush x:Key="MutedBrush" Color="#6A7080" />
            <SolidColorBrush x:Key="AccentBrush" Color="#3451D1" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#EEF0F4" />
            <SolidColorBrush x:Key="DangerBrush" Color="#D14343" />
            <SolidColorBrush x:Key="WarningBrush" Color="#B7791F" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B62" />
            <SolidColorBrush x:Key="SegSelectedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ChartBarBrush" Color="#3451D1" />

            <FontFamily x:Key="AppFont">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>

            <!-- カード。線はごくうすくして、うすい影で背景から少し浮かせる -->
            <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="2" Direction="270"
                              Opacity="0.06" Color="#000000" RenderingBias="Performance" />
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="Effect" Value="{StaticResource CardShadow}" />
            </Style>

            <!-- 画面の見出し。太すぎない文字で、大きめに -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>

            <!-- カードの見出し。小さく控えめにして、中身を目立たせる -->
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            </Style>

            <!-- 入力欄の上の小さな見出し -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <!-- 切り替えボタン（白い選択部分が動くタイプ。v6 の CTkSegmentedButton の代わり） -->
            <Style x:Key="SegmentedList" TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ItemsPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="16,7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegSelectedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 一覧の右側に並ぶ小さなアイコンボタン -->
            <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
