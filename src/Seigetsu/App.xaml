<Application x:Class="Seigetsu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 左メニューは明るい外観でも暗い色のまま（v6 と同じ） -->
            <SolidColorBrush x:Key="SidebarBrush" Color="#18233D" />
            <SolidColorBrush x:Key="SidebarTextBrush" Color="#D3DDEE" />
            <SolidColorBrush x:Key="SidebarMutedBrush" Color="#8D9BB6" />
            <SolidColorBrush x:Key="SidebarActiveBrush" Color="#2C3E66" />
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#223152" />
            <SolidColorBrush x:Key="MoonBrush" Color="#F3E7B8" />

            <!-- 外観で変わる色。ThemeService が明るい／暗いに合わせて差し替える -->
            <SolidColorBrush x:Key="BgBrush" Color="#EEF2F8" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LineBrush" Color="#DCE3EE" />
            <SolidColorBrush x:Key="TextBrush" Color="#1B2840" />
            <SolidColorBrush x:Key="MutedBrush" Color="#5D6B82" />
            <SolidColorBrush x:Key="AccentBrush" Color="#3B66C4" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#E8EEF8" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C94A4A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#B7791F" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B62" />
            <SolidColorBrush x:Key="SegSelectedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ChartBarBrush" Color="#3B66C4" />

            <FontFamily x:Key="AppFont">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>

            <!-- 白いカード -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            </Style>

            <!-- 入力欄の上の小さな見出し -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <!-- 切り替えボタン（白い選択部分が動くタイプ。v6 の CTkSegmentedButton の代わり） -->
            <Style x:Key="SegmentedList" TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ItemsPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="14,7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegSelectedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 一覧の右側に並ぶ小さなアイコンボタン -->
            <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
