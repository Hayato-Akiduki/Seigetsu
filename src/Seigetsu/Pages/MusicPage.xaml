<UserControl x:Class="Seigetsu.Pages.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="BGM" Style="{StaticResource PageTitle}" />
                <TextBlock Text="作業中に流す音楽（mp3 / wav / ogg）" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Primary"
                       Content="曲を追加" Icon="{ui:SymbolIcon Add24}" Padding="16,9" Click="OnAddClick" />
        </Grid>

        <!-- 再生中 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="40" Foreground="{DynamicResource AccentBrush}"
                                   Margin="4,0,18,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TrackText" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="StateText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource IconButton}" ToolTip="前の曲" AutomationProperties.Name="前の曲"
                                   Click="OnPreviousClick">
                            <ui:SymbolIcon Symbol="Previous24" FontSize="22" Foreground="{DynamicResource TextBrush}" />
                        </ui:Button>
                        <ui:Button x:Name="PlayButton" Appearance="Primary" Width="52" Height="52" Padding="0"
                                   Margin="8,0" CornerRadius="26" ToolTip="再生・一時停止"
                                   AutomationProperties.Name="再生・一時停止" Click="OnToggleClick">
                            <ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24" Filled="True" FontSize="22" />
                        </ui:Button>
                        <ui:Button Style="{StaticResource IconButton}" ToolTip="次の曲" AutomationProperties.Name="次の曲"
                                   Click="OnNextClick">
                            <ui:SymbolIcon Symbol="Next24" FontSize="22" Foreground="{DynamicResource TextBrush}" />
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="RepeatButton" Content="リピート" Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                               Padding="14,6" Margin="0,0,6,0" Click="OnRepeatClick" />
                    <ui:Button x:Name="ShuffleButton" Grid.Column="1" Content="シャッフル" Icon="{ui:SymbolIcon ArrowShuffle24}"
                               Padding="14,6" Margin="0,0,18,0" Click="OnShuffleClick" />
                    <TextBlock Grid.Column="2" Text="音量" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider x:Name="VolumeSlider" Grid.Column="3" Minimum="0" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            AutomationProperties.Name="音量" ValueChanged="OnVolumeChanged" />
                    <TextBlock x:Name="VolumeText" Grid.Column="4" Style="{StaticResource Muted}" Width="44"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- プレイリスト -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="プレイリスト" Style="{StaticResource CardTitle}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" FontSize="14" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"
                                   Text="曲がありません。&#10;「曲を追加」から追加してください。" />
                        <ItemsControl x:Name="TrackList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding RowBrush}" CornerRadius="10" Padding="6,2" Margin="0,0,4,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" FontSize="13" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{Binding NumberBrush}" />
                                            <!-- ダブルクリックでも再生できる -->
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" VerticalAlignment="Center"
                                                       FontWeight="{Binding Weight}" Foreground="{Binding NameBrush}"
                                                       TextTrimming="CharacterEllipsis" Background="Transparent"
                                                       ToolTip="{Binding Track.Path}" MouseLeftButtonDown="OnNameMouseDown" />
                                            <ui:Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="再生"
                                                       AutomationProperties.Name="{Binding Track.FileName, StringFormat={}{0} を再生}"
                                                       Click="OnPlayRowClick">
                                                <ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="{DynamicResource AccentBrush}" />
                                            </ui:Button>
                                            <ui:Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="プレイリストから外す"
                                                       AutomationProperties.Name="{Binding Track.FileName, StringFormat={}{0} を外す}"
                                                       Click="OnRemoveClick">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource DangerBrush}" />
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                           Text="ヒント：音楽ファイルをウィンドウにドラッグ＆ドロップしても追加できます。" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
