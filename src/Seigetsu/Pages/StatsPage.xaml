<UserControl x:Class="Seigetsu.Pages.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Seigetsu.Controls"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="分析" Style="{StaticResource PageTitle}" />
                <TextBlock Text="集中タイマーで記録した作業時間（休憩は含みません）" Style="{StaticResource Muted}"
                           FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="CSVで書き出す"
                       Icon="{ui:SymbolIcon ArrowDownload24}" Padding="16,9" Click="OnExportClick" />
        </Grid>

        <!-- 合計のタイル -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,16">
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="今日" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock x:Name="TodayText" FontSize="26" FontWeight="Light" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="直近7日間" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock x:Name="WeekText" FontSize="26" FontWeight="Light" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="今月" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock x:Name="MonthText" FontSize="26" FontWeight="Light" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="累計" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock x:Name="AllText" FontSize="26" FontWeight="Light" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- グラフ -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ChartTitle" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                    <ui:Button x:Name="ViewButton" Grid.Column="1" Content="表で見る" Icon="{ui:SymbolIcon Table24}"
                               Padding="12,6" Margin="0,0,10,0" Click="OnViewClick" />
                    <ListBox x:Name="ModeList" Grid.Column="2" Style="{StaticResource SegmentedList}"
                             SelectionChanged="OnModeChanged">
                        <ListBoxItem Content="週間" IsSelected="True" />
                        <ListBoxItem Content="曜日別" />
                        <ListBoxItem Content="月間" />
                    </ListBox>
                </Grid>

                <controls:BarChart x:Name="Chart" Grid.Row="1" />

                <!-- 表で見る（グラフと同じ数字を一覧で） -->
                <ScrollViewer x:Name="TableView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="TableRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Padding="4,8">
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" FontSize="14" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="14" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
