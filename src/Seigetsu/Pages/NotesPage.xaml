<UserControl x:Class="Seigetsu.Pages.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="メモ" Style="{StaticResource PageTitle}" />
                <TextBlock Text="入力した内容は自動で保存されます" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="TXTで書き出す"
                       Icon="{ui:SymbolIcon ArrowDownload24}" Padding="16,9" Click="OnExportClick" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 本文。Ctrl+Z で元に戻せる -->
                <TextBox x:Name="Body" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         VerticalContentAlignment="Top" FontSize="15" Padding="14"
                         Background="Transparent" BorderThickness="0" Margin="6,6,6,0"
                         Foreground="{DynamicResource TextBrush}" IsUndoEnabled="True"
                         AutomationProperties.Name="メモの本文"
                         CaretBrush="{DynamicResource TextBrush}"
                         TextChanged="OnTextChanged">
                    <!-- WPF-UI の枠付きの見た目を使わず、カードと一体に見せる -->
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          Background="Transparent" Focusable="False" />
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <Grid Grid.Row="1" Margin="20,4,20,12">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="12" Text="保存済み" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
