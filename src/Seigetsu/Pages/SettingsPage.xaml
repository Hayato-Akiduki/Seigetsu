<UserControl x:Class="Seigetsu.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="設定" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <!-- 外観 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="外観" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="画面の明るさを選べます。" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
                        <ListBox x:Name="AppearanceList" Style="{StaticResource SegmentedList}" HorizontalAlignment="Left"
                                 SelectionChanged="OnAppearanceChanged">
                            <ListBoxItem Content="ライト" Tag="LIGHT" />
                            <ListBoxItem Content="ダーク" Tag="DARK" />
                            <ListBoxItem Content="Windows に合わせる" Tag="SYSTEM" />
                        </ListBox>

                        <TextBlock Text="背景画像" Style="{StaticResource FieldLabel}" Margin="0,18,0,2" />
                        <TextBlock Text="好きな画像を敷けます。出す場所は下で選べます（はじめは、窓全体と時計の大画面）。" Style="{StaticResource Muted}"
                                   FontSize="12" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="画像を選ぶ" Icon="{ui:SymbolIcon Image24}" Padding="14,8"
                                       Click="OnChooseBackgroundClick" />
                            <ui:Button x:Name="ClearBackgroundButton" Content="解除" Padding="14,8" Margin="8,0,0,0"
                                       Click="OnClearBackgroundClick" />
                            <TextBlock x:Name="BackgroundText" Style="{StaticResource Muted}" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                       MaxWidth="360" />
                        </StackPanel>
                        <StackPanel x:Name="BackgroundOptions" Margin="0,12,0,0">
                            <TextBlock Text="出す場所" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6" />
                            <WrapPanel>
                                <CheckBox x:Name="BackgroundBannerCheck" Content="ホームの上帯" Margin="0,0,20,0"
                                          Click="OnBackgroundPlaceClick" Tag="Banner" />
                                <CheckBox x:Name="BackgroundWindowCheck" Content="窓全体" Margin="0,0,20,0"
                                          Click="OnBackgroundPlaceClick" Tag="Window" />
                                <CheckBox x:Name="BackgroundClockCheck" Content="時計の大画面"
                                          Click="OnBackgroundPlaceClick" Tag="Clock" />
                            </WrapPanel>
                            <TextBlock Text="窓全体に敷いた画像の濃さ" Style="{StaticResource Muted}" FontSize="13" Margin="0,12,0,6" />
                            <ListBox x:Name="BackgroundStrengthList" Style="{StaticResource SegmentedList}" HorizontalAlignment="Left"
                                     SelectionChanged="OnBackgroundStrengthChanged">
                                <ListBoxItem Content="こい" Tag="STRONG" />
                                <ListBoxItem Content="ふつう" Tag="NORMAL" />
                                <ListBoxItem Content="うすい" Tag="WEAK" />
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ホームの上帯のことば -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ホームの上帯のことば" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="ホームを開いたときはあいさつを出し、時間がたつと下で選んだことばに順番に切り替えます。ことばを押しても切り替わります。" />
                        <TextBlock Text="出すもの" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6" />
                        <WrapPanel x:Name="BannerKindsPanel" />
                        <TextBlock Text="切り替える間隔" Style="{StaticResource Muted}" FontSize="13" Margin="0,12,0,6" />
                        <ListBox x:Name="BannerIntervalList" Style="{StaticResource SegmentedList}" HorizontalAlignment="Left"
                                 SelectionChanged="OnBannerIntervalChanged">
                            <ListBoxItem Content="30 秒" Tag="30" />
                            <ListBoxItem Content="1 分" Tag="60" />
                            <ListBoxItem Content="5 分" Tag="300" />
                            <ListBoxItem Content="10 分" Tag="600" />
                        </ListBox>
                        <TextBlock Text="自分で書いたことば（1 行に 1 つ）" Style="{StaticResource Muted}" FontSize="13" Margin="0,12,0,6" />
                        <TextBox x:Name="BannerCustomBox" AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                 VerticalScrollBarVisibility="Auto" MaxWidth="560" HorizontalAlignment="Left" Width="560"
                                 AutomationProperties.Name="自分で書いたことば" LostFocus="OnBannerCustomLostFocus" />
                        <TextBlock Text="入力欄から出ると保存します。" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 集中タイマー -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="集中タイマー（ポモドーロ）" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="作業と休憩の長さ（分）です。" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="作業" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="WorkBox" Width="100" AutomationProperties.Name="作業の長さ（分）"
                                      SelectionChanged="OnWorkChanged" />
                            <TextBlock Text="休憩" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" Margin="24,0,8,0" />
                            <ComboBox x:Name="BreakBox" Width="100" AutomationProperties.Name="休憩の長さ（分）"
                                      SelectionChanged="OnBreakChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 締切の通知 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="タスクの締切の通知" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="今日が締切のタスクや期限切れのタスクがあると、1 日 1 回 Windows の通知で知らせます。" />
                        <ListBox x:Name="DueNotifyList" Style="{StaticResource SegmentedList}" HorizontalAlignment="Left"
                                 SelectionChanged="OnDueNotifyChanged">
                            <ListBoxItem Content="知らせる" Tag="1" />
                            <ListBoxItem Content="知らせない" Tag="0" />
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- × ボタン -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ウィンドウの × ボタン" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="タスクトレイに格納すると、タイマーや音楽を動かしたまま画面を隠せます。終わるときは、タスクトレイのアイコンを右クリックして「終了」を選ぶか、Ctrl+Q を押します。" />
                        <ListBox x:Name="CloseActionList" Style="{StaticResource SegmentedList}" HorizontalAlignment="Left"
                                 SelectionChanged="OnCloseActionChanged">
                            <ListBoxItem Content="アプリを終了する" Tag="quit" />
                            <ListBoxItem Content="タスクトレイに格納する" Tag="tray" />
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Windows の起動時 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Windows の起動時" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="Windows にサインインしたときに、霽月を自動で起動します。起動した霽月は最小化しておきます（× ボタンを「タスクトレイに格納する」にしているときは、タスクトレイに入れておきます）。" />
                        <ListBox x:Name="AutoStartList" Style="{StaticResource SegmentedList}" HorizontalAlignment="Left"
                                 SelectionChanged="OnAutoStartChanged">
                            <ListBoxItem Content="自動で起動する" Tag="1" />
                            <ListBoxItem Content="起動しない" Tag="0" />
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- 天気 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="天気" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="ホームに出す天気の地域です（例：Nagasaki、東京、Sapporo）。"
                                   Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox x:Name="CityBox" Width="240" PlaceholderText="Nagasaki" KeyDown="OnCityKeyDown"
                                        AutomationProperties.Name="天気の地域" />
                            <ui:Button Content="保存して更新" Appearance="Primary" Padding="16,8" Margin="8,0,0,0"
                                       Click="OnSaveCityClick" />
                        </StackPanel>
                        <TextBlock Text="天気データ：Open-Meteo（https://open-meteo.com）" Style="{StaticResource Muted}"
                                   FontSize="12" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- データ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="データ" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock x:Name="DataPathText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="BackupText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="DailyBackupText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <ui:Button Content="CSVで書き出す" Icon="{ui:SymbolIcon ArrowDownload24}" Padding="14,7"
                                       Margin="0,0,8,8" Click="OnExportClick" />
                            <ui:Button Content="データのフォルダを開く" Icon="{ui:SymbolIcon FolderOpen24}" Padding="14,7"
                                       Margin="0,0,8,8" Click="OnOpenFolderClick" />
                            <ui:Button Content="バックアップのフォルダを開く" Icon="{ui:SymbolIcon History24}" Padding="14,7"
                                       Margin="0,0,8,8" Click="OnOpenBackupFolderClick" />
                            <ui:Button Content="スクリーンショットのフォルダを開く" Icon="{ui:SymbolIcon Screenshot24}" Padding="14,7"
                                       Margin="0,0,8,8" Click="OnOpenScreenshotFolderClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- アップデート -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="アップデート" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                   Text="新しい版が出ると、自動でダウンロードして、アプリを閉じたときに更新します。" />
                        <TextBlock x:Name="UpdateStatusText" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button x:Name="CheckUpdateButton" Content="新しい版を確認" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Padding="14,7" Margin="0,0,8,0" Click="OnCheckUpdateClick" />
                            <ui:Button x:Name="UpdateNowButton" Content="今すぐ更新して再起動" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Appearance="Primary" Padding="14,7" Visibility="Collapsed" Click="OnUpdateNowClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- このアプリについて -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="このアプリについて" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="使っている部品：WPF-UI、Microsoft.Data.Sqlite、NAudio、NAudio.Vorbis、Velopack（いずれも MIT ライセンス）" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
