<UserControl x:Class="Seigetsu.Pages.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded" SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <!-- 月表示の 1 日分。Tag が "selected" のときは選択中の色のまま、マウスを乗せても変えない -->
        <!-- キーボードで日付を選んでいるときだけ出る枠（マウスで押したときは出ない） -->
        <Style x:Key="DayFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource MutedBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayCell" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DayFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="normal" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- せまい幅（画面の半分など）では、選んだ日のタスクを月の表示の下に回す（CalendarPage.xaml.cs の OnSizeChanged） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="DayRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition x:Name="DayGap" Width="16" />
            <ColumnDefinition x:Name="DayColumn" Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="カレンダー" Style="{StaticResource PageTitle}" />
                <TextBlock Text="締切日を設定したタスクが表示されます" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <!-- 長崎大学モードのときだけ出す -->
                <ui:Button x:Name="NagasakiButton" Content="大学の情報を更新" Icon="{ui:SymbolIcon ArrowSync24}"
                           Padding="16,9" Margin="0,0,8,0" Click="OnNagasakiClick" Visibility="Collapsed"
                           ToolTip="NU-Web の時間割と LACS の課題を今すぐ読み込みます（ふだんは自動で更新します）" />
                <ui:Button Appearance="Primary" Content="この日にタスクを追加" Icon="{ui:SymbolIcon Add24}" Padding="16,9"
                           Click="OnAddClick" />
            </StackPanel>
        </Grid>

        <!-- 月の表示 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Style="{StaticResource IconButton}" ToolTip="前の月" AutomationProperties.Name="前の月"
                               Click="OnPrevClick">
                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="18" Foreground="{DynamicResource TextBrush}" />
                    </ui:Button>
                    <TextBlock x:Name="MonthText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <ui:Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="次の月" AutomationProperties.Name="次の月"
                               Click="OnNextClick">
                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="18" Foreground="{DynamicResource TextBrush}" />
                    </ui:Button>
                    <ui:Button Grid.Column="3" Content="今日" Padding="14,6" Margin="8,0,0,0" Click="OnTodayClick" />
                </Grid>

                <!-- 曜日（日曜は赤、土曜は青） -->
                <UniformGrid x:Name="WeekHeader" Grid.Row="1" Columns="7" Margin="0,0,0,4" />

                <!-- 6 週 × 7 日。中身は画面を作るときに用意する -->
                <UniformGrid x:Name="DayGrid" Grid.Row="2" Columns="7" Rows="6" />
            </Grid>
        </Border>

        <!-- 選んだ日のタスク -->
        <Border x:Name="DayPanel" Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="DayTitle" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="DaySub" Grid.Row="1" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 時間割（長崎大学モードで取り込んだもの）。その曜日の授業 -->
                        <StackPanel x:Name="ClassesPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock Text="授業" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,0,6" />
                            <ItemsControl x:Name="DayClasses">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,6" Margin="0,0,4,6" BorderThickness="3,0,0,0"
                                                BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SubtleBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Width="64" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PeriodText}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Slot.Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextBrush}" ToolTip="{Binding Slot.Title}" />
                                                    <TextBlock Text="{Binding Slot.Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource MutedBrush}" Visibility="{Binding DetailVisibility}"
                                                               ToolTip="{Binding Slot.Detail}" />
                                                    <!-- 教室（シラバスから読んだもの） -->
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding RoomVisibility}" Margin="0,2,0,0">
                                                        <ui:SymbolIcon Symbol="Location16" FontSize="12" Margin="0,0,3,0"
                                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Slot.Room}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextBrush}" ToolTip="{Binding Slot.Room}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="締切のタスク" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="NoTasksText" Text="この日が締切のタスクはありません。" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />
                        <ItemsControl x:Name="DayTasks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SubtleBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Task.Completed, Mode=OneWay}" Click="OnCompletedClick"
                                                      MinWidth="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Task.Title, StringFormat={}{0} を完了}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Task.Title}" FontSize="14" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Foreground="{Binding TitleBrush}"
                                                       TextDecorations="{Binding TitleDecorations}" />
                                            <TextBlock Grid.Column="2" Text="{Binding PriorityText}" FontSize="12" Margin="6,0"
                                                       VerticalAlignment="Center" Foreground="{Binding PriorityBrush}" />
                                            <ui:Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="編集"
                                                       Click="OnEditClick"
                                                       AutomationProperties.Name="{Binding Task.Title, StringFormat={}{0} を編集}">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="16" Foreground="{DynamicResource MutedBrush}" />
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
