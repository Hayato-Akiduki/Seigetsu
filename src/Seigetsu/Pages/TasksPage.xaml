<UserControl x:Class="Seigetsu.Pages.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 見出しと追加ボタン -->
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="タスク" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Primary"
                       Content="新しいタスク" Icon="{ui:SymbolIcon Add24}" Padding="16,9"
                       ToolTip="Ctrl+N" Click="OnAddClick" />
        </Grid>

        <!-- 検索と絞り込み -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="タスク名・カテゴリで検索"
                        Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0"
                        TextChanged="OnSearchChanged" />
            <ListBox x:Name="FilterList" Grid.Column="1" Style="{StaticResource SegmentedList}"
                     SelectionChanged="OnFilterChanged">
                <ListBoxItem Content="すべて" />
                <ListBoxItem Content="未完了" IsSelected="True" />
                <ListBoxItem Content="完了" />
                <ListBoxItem Content="お気に入り" />
                <ListBoxItem Content="期限切れ" />
            </ListBox>
        </Grid>

        <!-- 一覧 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" FontSize="14"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,60,0,0"
                           Visibility="Collapsed" />
                <ItemsControl x:Name="TaskList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,6,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding Task.Completed, Mode=OneWay}" Click="OnCompletedClick"
                                              MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                              ToolTip="完了にする"
                                              AutomationProperties.Name="{Binding Task.Title, StringFormat={}{0} を完了}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Task.Title}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding TitleBrush}"
                                                   TextDecorations="{Binding TitleDecorations}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding PriorityText}" FontSize="12"
                                                       Foreground="{Binding PriorityBrush}" />
                                            <TextBlock Text="{Binding CategoryText}" FontSize="12" Margin="14,0,0,0"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding DueText}" FontSize="12" Margin="14,0,0,0"
                                                       Foreground="{Binding DueBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Style="{StaticResource IconButton}" ToolTip="お気に入り"
                                                   AutomationProperties.Name="{Binding Task.Title, StringFormat={}{0} をお気に入り}"
                                                   Click="OnFavoriteClick">
                                            <ui:SymbolIcon Symbol="Star24" FontSize="18" Filled="{Binding Task.Favorite}"
                                                           Foreground="{Binding FavoriteBrush}" />
                                        </ui:Button>
                                        <ui:Button Style="{StaticResource IconButton}" ToolTip="編集"
                                                   AutomationProperties.Name="{Binding Task.Title, StringFormat={}{0} を編集}"
                                                   Click="OnEditClick">
                                            <ui:SymbolIcon Symbol="Edit24" FontSize="18"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                        </ui:Button>
                                        <ui:Button Style="{StaticResource IconButton}" ToolTip="削除"
                                                   AutomationProperties.Name="{Binding Task.Title, StringFormat={}{0} を削除}"
                                                   Click="OnDeleteClick">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="18"
                                                           Foreground="{DynamicResource DangerBrush}" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
