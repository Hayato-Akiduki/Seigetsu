<UserControl x:Class="Seigetsu.Pages.BoardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="掲示板" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <ui:Button x:Name="PinButton" HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Primary"
                       Content="貼る" Icon="{ui:SymbolIcon Pin24}" Padding="16,9" Click="OnPinClick" />
        </Grid>

        <!-- 掲示板の面。右クリックした場所にも貼れる -->
        <Border x:Name="Surface" Grid.Row="1" CornerRadius="14" BorderThickness="1"
                BorderBrush="{DynamicResource LineBrush}" ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="OnScrollChanged">
                    <Canvas x:Name="Board" Background="Transparent" MouseRightButtonUp="OnBoardRightClick" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" FontSize="14" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Text="まだ何も貼っていません。&#10;右上の「貼る」か、ここを右クリックして、メモ・付箋・タスクを貼れます。&#10;貼ったものはドラッグで好きな場所に動かせます。"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
