<UserControl x:Class="Seigetsu.Pages.LacsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
    <!-- 長崎大学モードのときだけ左メニューに出るページ。左に授業の一覧、右に授業のページ。配られた PDF もここで開く -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 操作の帯 -->
        <Grid Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LACS" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource TextBrush}" />
                <ui:Button Style="{StaticResource IconButton}" Click="OnListToggleClick" Margin="0,0,4,0"
                           ToolTip="授業の一覧を隠す・出す" AutomationProperties.Name="授業の一覧を隠す・出す">
                    <ui:SymbolIcon x:Name="ListToggleIcon" Symbol="PanelLeftContract24" FontSize="18"
                                   Foreground="{DynamicResource TextBrush}" />
                </ui:Button>
                <ui:Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="OnBackClick" Margin="0,0,4,0"
                           ToolTip="戻る（Alt+←）" AutomationProperties.Name="戻る" IsEnabled="False">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" Foreground="{DynamicResource TextBrush}" />
                </ui:Button>
                <ui:Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Click="OnForwardClick" Margin="0,0,4,0"
                           ToolTip="進む（Alt+→）" AutomationProperties.Name="進む" IsEnabled="False">
                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="18" Foreground="{DynamicResource TextBrush}" />
                </ui:Button>
                <ui:Button Style="{StaticResource IconButton}" Click="OnReloadClick" Margin="0,0,8,0"
                           ToolTip="読み込み直す（F5）" AutomationProperties.Name="読み込み直す">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18" Foreground="{DynamicResource TextBrush}" />
                </ui:Button>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" />
            <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
                <!-- LACS の資料の画面にいるときだけ出す。LACS の小さなプレビューの代わりに、ファイルを大きく開く -->
                <ui:Button x:Name="BigPdfButton" Appearance="Primary" Content="PDF を大きく開く"
                           Icon="{ui:SymbolIcon DocumentPdf24}" Padding="12,6" Margin="8,0,0,0"
                           Click="OnBigPdfClick" Visibility="Collapsed"
                           ToolTip="LACS の画面を通さずに、この資料を大きく開きます" />
                <ui:Button x:Name="FullScreenButton" Content="全画面" Icon="{ui:SymbolIcon FullScreenMaximize24}"
                           Padding="12,6" Margin="8,0,0,0"
                           Click="OnFullScreenClick" ToolTip="左のメニューと授業の一覧を隠して、画面いっぱいにします（F11）" />
                <ui:Button Content="ブラウザで開く" Icon="{ui:SymbolIcon Open24}" Padding="12,6" Margin="8,0,0,0"
                           Click="OnOpenInBrowserClick" ToolTip="今のページをふだんのブラウザで開きます" />
            </WrapPanel>
        </Grid>

        <!-- 授業の一覧 -->
        <Border x:Name="ListPanel" Grid.Row="1" Margin="0,0,12,0" Padding="8" CornerRadius="10"
                Background="{DynamicResource SubtleBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="授業" FontSize="13" FontWeight="Bold" Margin="6,2,0,6"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="ListMessage" Grid.Row="1" FontSize="12" TextWrapping="Wrap" Margin="6,4"
                           Foreground="{DynamicResource MutedBrush}" />
                <ListBox x:Name="CourseList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnCourseSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- 読み上げソフトには授業名を読ませる（何もしないと中身の記録がそのまま読まれる） -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding Code}" FontSize="10" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" CornerRadius="10" ClipToBounds="True"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <wv2:WebView2 x:Name="Browser" />
        </Border>
    </Grid>
</UserControl>
