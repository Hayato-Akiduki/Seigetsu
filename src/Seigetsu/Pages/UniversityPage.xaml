<UserControl x:Class="Seigetsu.Pages.UniversityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded" SizeChanged="OnSizeChanged">
    <!-- 長崎大学モードのときだけ左メニューに出るページ。今日の授業と LACS の未提出の課題をまとめて見る -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="SecondRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition x:Name="Gap" Width="16" />
            <ColumnDefinition x:Name="SecondColumn" Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3" Margin="0,0,0,18">
            <!-- 左に題名と更新の結果、右にボタン。結果の文が長くてもボタンに重ならないよう、列を分ける -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="大学" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <!-- 「今日」「LACS の連絡」「NU-Web の連絡」の切り替え -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button x:Name="TodayTab" Content="今日" Icon="{ui:SymbolIcon CalendarToday24}" Padding="14,6"
                               Margin="0,0,8,0" Click="OnTodayTabClick" />
                    <ui:Button x:Name="LacsTab" Content="LACS の連絡" Icon="{ui:SymbolIcon Megaphone24}"
                               Padding="14,6" Margin="0,0,8,0" Click="OnLacsTabClick" />
                    <ui:Button x:Name="NuWebTab" Content="NU-Web の連絡" Icon="{ui:SymbolIcon Megaphone24}"
                               Padding="14,6" Click="OnNuWebTabClick" />
                </StackPanel>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ui:Button Content="NU-Web" Icon="{ui:SymbolIcon Open24}" Padding="14,9" Margin="0,0,8,0"
                           Click="OnNuWebClick" ToolTip="NU-Web をブラウザで開きます" />
                <ui:Button Content="LACS の授業" Icon="{ui:SymbolIcon BookOpen24}" Padding="14,9" Margin="0,0,8,0"
                           Click="OnLacsClick" ToolTip="LACS の授業のページや配られた PDF を、霽月の中で見ます" />
                <ui:Button x:Name="SyncButton" Appearance="Primary" Content="今すぐ更新" Icon="{ui:SymbolIcon ArrowSync24}"
                           Padding="16,9" Click="OnSyncClick"
                           ToolTip="NU-Web の時間割と LACS の課題を今すぐ読み込みます（ふだんは自動で更新します）" />
            </WrapPanel>
        </Grid>

        <!-- 今日の授業 -->
        <Border x:Name="ClassesPanel" Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ClassesTitle" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="ClassesSub" Grid.Row="1" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="NoClassesText" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,40,0,0" Visibility="Collapsed" />
                        <ItemsControl x:Name="Classes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 押すと、その授業の LACS のページを開く -->
                                    <Border CornerRadius="10" Padding="12,10" Margin="0,0,4,8" BorderThickness="3,0,0,0"
                                            BorderBrush="{Binding Bar}" Background="{DynamicResource SubtleBrush}"
                                            Opacity="{Binding Opacity}" Cursor="Hand" Focusable="True"
                                            ToolTip="押すと、この授業の LACS のページを開きます"
                                            AutomationProperties.Name="{Binding Slot.Title}"
                                            MouseLeftButtonUp="OnClassClick" KeyDown="OnClassKeyDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Width="84" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PeriodText}" FontSize="15" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Slot.Title}" FontSize="15" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextBrush}" ToolTip="{Binding Slot.Title}" />
                                                <TextBlock Text="{Binding Slot.Detail}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedBrush}" Visibility="{Binding DetailVisibility}"
                                                           ToolTip="{Binding Slot.Detail}" />
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding RoomVisibility}" Margin="0,2,0,0">
                                                    <ui:SymbolIcon Symbol="Location16" FontSize="13" Margin="0,0,3,0"
                                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Slot.Room}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextBrush}" ToolTip="{Binding Slot.Room}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- 「授業中」「次」 -->
                                            <Border Grid.Column="2" CornerRadius="8" Padding="8,2" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"
                                                    Visibility="{Binding BadgeVisibility}">
                                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource OnAccentBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- LACS の未提出の課題 -->
        <Border x:Name="AssignmentsPanel" Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="LACS の未提出の課題" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="AssignmentsSub" Grid.Row="1" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="NoAssignmentsText" Text="未提出の課題はありません。" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />
                        <ItemsControl x:Name="Assignments">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 押すと、LACS のページでこの課題の画面を開く -->
                                    <Border CornerRadius="10" Padding="12,8" Margin="0,0,4,8" Background="{DynamicResource SubtleBrush}"
                                            Cursor="Hand" Focusable="True" ToolTip="押すと、LACS でこの課題の画面を開きます"
                                            AutomationProperties.Name="{Binding Task.Title}"
                                            MouseLeftButtonUp="OnAssignmentClick" KeyDown="OnAssignmentKeyDown">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Task.Title}" FontSize="14" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{Binding DueText}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{Binding DueBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- お知らせ（LACS の連絡事項と NU-Web の掲示）の一覧表。左に表、右に選んだお知らせの本文（せまい幅では本文を表の下に回す）。
             行の左端の線の色で出どころを見分ける: LACS は青、NU-Web は緑 -->
        <Grid x:Name="AnnouncementsView" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="DetailRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition x:Name="DetailGap" Width="16" />
                <ColumnDefinition x:Name="DetailColumn" Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="AnnouncementsTitleBar" Width="4" Height="20" CornerRadius="2" Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                <TextBlock x:Name="AnnouncementsTitle" Text="LACS の連絡" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="AnnouncementsSub" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,12,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button x:Name="MarkAllButton" Grid.Column="1" Content="すべて読んだことにする"
                                   Icon="{ui:SymbolIcon CheckmarkCircle24}" Padding="12,6" VerticalAlignment="Top"
                                   Click="OnMarkAllClick" />
                    </Grid>
                    <!-- 絞り込み -->
                    <WrapPanel Grid.Row="1" Margin="0,10,0,8">
                        <TextBlock x:Name="CourseFilterLabel" Text="授業" VerticalAlignment="Center" Margin="0,0,6,4"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <ComboBox x:Name="CourseFilter" MinWidth="220" Margin="0,0,8,4" SelectionChanged="OnFilterChanged"
                                  AutomationProperties.Name="授業で絞り込む" />
                        <ui:TextBox x:Name="SearchBox" PlaceholderText="題名・本文で探す" MinWidth="200" Margin="0,0,8,4"
                                    TextChanged="OnFilterChanged" AutomationProperties.Name="題名・本文で探す" />
                        <CheckBox x:Name="UnseenOnly" Content="まだ読んでいないものだけ" VerticalAlignment="Center"
                                  Margin="0,0,0,4" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                    </WrapPanel>
                    <TextBlock x:Name="NoAnnouncementsText" Grid.Row="2" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />
                    <ListBox x:Name="AnnouncementList" Grid.Row="2" SelectionMode="Single"
                              SelectionChanged="OnAnnouncementSelected" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 表の 1 行: 未読の印・日付・授業・題名。選んだ行（青い背景）では文字を背景に合う色にする -->
                                <Grid Margin="0,4">
                                    <Grid.Resources>
                                        <Style x:Key="RowText" TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource RowText}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 出どころの線（LACS は青、NU-Web は緑） -->
                                    <Border Width="4" CornerRadius="2" HorizontalAlignment="Left" Margin="0,-2"
                                            Background="{Binding SourceBrush}" ToolTip="{Binding SourceName}" />
                                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                             Visibility="{Binding UnseenVisibility}" />
                                    <TextBlock Grid.Column="2" Text="{Binding DateText}" FontSize="12" VerticalAlignment="Center"
                                               Style="{StaticResource RowText}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Item.CourseName}" FontSize="12" Margin="0,0,12,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource RowText}" ToolTip="{Binding Item.CourseName}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Item.Title}" FontSize="14" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" FontWeight="{Binding TitleWeight}"
                                               Style="{StaticResource RowTitle}" ToolTip="{Binding Item.Title}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 選んだお知らせの本文。題名の左にも、出どころの色の線を出す -->
            <Border x:Name="DetailPanel" Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="DetailSourceBar" Width="4" CornerRadius="2" HorizontalAlignment="Left"
                            Margin="0,2,0,10" Visibility="Collapsed" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" Text="お知らせを選ぶと、ここに本文が出ます" />
                        <TextBlock x:Name="DetailMeta" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- 本文は選んでコピーできるように、読むだけの入力欄で出す -->
                    <TextBox x:Name="DetailBody" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                             Background="Transparent" FontSize="14" VerticalScrollBarVisibility="Auto"
                             Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="連絡の本文" />
                    <ui:Button x:Name="OpenInLacsButton" Grid.Row="2" Content="LACS でこの授業の連絡を開く"
                               Icon="{ui:SymbolIcon BookOpen24}" Padding="12,6" Margin="0,10,0,0"
                               Click="OnOpenInLacsClick" IsEnabled="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
