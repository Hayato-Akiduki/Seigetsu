<UserControl x:Class="Seigetsu.Pages.RecommendPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- 作者がおすすめするアプリやサイトの一覧。中身は RecommendPage.xaml.cs の Items で決める -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="おすすめ" Style="{StaticResource PageTitle}" />
            <TextBlock Text="霽月の作者がおすすめするアプリやサイトです。押すとブラウザで開きます。"
                       Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- 「アプリ」「サイト」などの分類ごとに、見出しとカードを並べる -->
            <ItemsControl x:Name="Groups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Width="300" Padding="18,16" Margin="0,0,14,14"
                                                Cursor="Hand" Focusable="True" ToolTip="{Binding Url}"
                                                AutomationProperties.Name="{Binding Name}"
                                                MouseLeftButtonUp="OnItemClick" KeyDown="OnItemKeyDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                                                        Background="{DynamicResource SubtleBrush}">
                                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ui:SymbolIcon Grid.Column="2" Symbol="Open24" FontSize="16" VerticalAlignment="Top"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
