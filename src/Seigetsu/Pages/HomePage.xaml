<UserControl x:Class="Seigetsu.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- あいさつと日付・時刻。背景画像を選んでいると、その画像を暗めに敷いて白い文字にする（v6 と同じ） -->
            <Border x:Name="Banner" CornerRadius="16" Margin="0,0,0,22" ClipToBounds="True">
                <Grid>
                    <!-- 画像の上に重ねる暗い膜（文字を読みやすくする） -->
                    <Border x:Name="BannerShade" Background="#000000" Opacity="0.45" CornerRadius="16"
                            Visibility="Collapsed" />
                    <Grid x:Name="BannerContent">
                        <StackPanel>
                            <TextBlock x:Name="GreetingText" Style="{StaticResource PageTitle}" />
                            <TextBlock x:Name="DateText" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
                        </StackPanel>
                        <!-- 時刻を押すと、時計を大画面で出す -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText" FontSize="34" FontWeight="Light" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" Cursor="Hand"
                                       ToolTip="時計を大画面で表示（F11）" MouseLeftButtonUp="OnBigClockClick" />
                            <ui:Button Style="{StaticResource IconButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       ToolTip="時計を大画面で表示（F11）" Click="OnBigClockClick"
                                       AutomationProperties.Name="時計を大画面で表示">
                                <ui:SymbolIcon x:Name="BigClockIcon" Symbol="FullScreenMaximize24" FontSize="20"
                                               Foreground="{DynamicResource MutedBrush}" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 数字のカード -->
            <UniformGrid Columns="3" Margin="-8,0,-8,16">
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="未完了のタスク" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="OpenTasksText" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="今日の作業時間" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TodayWorkText" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="これまでの作業時間" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TotalWorkText" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 今日のタスク -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="今日のタスク" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="NoTasksText" Text="今日やるタスクはありません。" Style="{StaticResource Muted}"
                                   Visibility="Collapsed" />
                        <ItemsControl x:Name="TaskList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="10"
                                            Background="{DynamicResource SubtleBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{Binding PriorityBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                            <ui:SymbolIcon Grid.Column="2" Symbol="Star24" Filled="True" FontSize="16"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           Visibility="{Binding FavoriteVisibility}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- 天気 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="天気" Style="{StaticResource CardTitle}" />
                                <ui:Button x:Name="WeatherRefreshButton" Style="{StaticResource IconButton}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0"
                                           ToolTip="天気を更新" AutomationProperties.Name="天気を更新"
                                           Click="OnWeatherRefreshClick">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Foreground="{DynamicResource MutedBrush}" />
                                </ui:Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="WeatherIcon" Symbol="WeatherCloudy24" FontSize="38"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="WeatherTitle" Text="天気" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock x:Name="WeatherDetail" Text="確認しています…" Style="{StaticResource Muted}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ツール -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ツール" Style="{StaticResource CardTitle}" />
                            <!-- v6 と同じ 4 つ -->
                            <UniformGrid Columns="2">
                                <ui:Button Content="電卓" Icon="{ui:SymbolIcon Calculator24}" HorizontalAlignment="Stretch"
                                           Margin="0,0,4,8" Padding="10,8" Click="OnCalculatorClick" />
                                <ui:Button Content="文字数" Icon="{ui:SymbolIcon TextWordCount24}" HorizontalAlignment="Stretch"
                                           Margin="4,0,0,8" Padding="10,8" Click="OnCounterClick" />
                                <ui:Button Content="スクショ" Icon="{ui:SymbolIcon Screenshot24}" HorizontalAlignment="Stretch"
                                           Margin="0,0,4,0" Padding="10,8" Click="OnScreenshotClick"
                                           ToolTip="すべての画面を撮って、ピクチャの Seigetsu フォルダに保存します" />
                                <ui:Button Content="付箋" Icon="{ui:SymbolIcon Note24}" HorizontalAlignment="Stretch"
                                           Margin="4,0,0,0" Padding="10,8" Click="OnNewStickyClick"
                                           ToolTip="新しい付箋を書く" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- データの場所 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="データの場所" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                            <TextBlock x:Name="DbPathText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="v6 と同じデータを使っています。"
                                       Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
