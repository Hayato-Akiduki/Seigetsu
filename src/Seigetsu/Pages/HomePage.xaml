<UserControl x:Class="Seigetsu.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- あいさつと日付・時刻 -->
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="GreetingText" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="DateText" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
                <!-- 時刻を押すと、時計を大画面で出す -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" FontSize="34" FontWeight="Light" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Cursor="Hand"
                               ToolTip="時計を大画面で表示（F11）" MouseLeftButtonUp="OnBigClockClick" />
                    <ui:Button Style="{StaticResource IconButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                               ToolTip="時計を大画面で表示（F11）" Click="OnBigClockClick"
                               AutomationProperties.Name="時計を大画面で表示">
                        <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="20" Foreground="{DynamicResource MutedBrush}" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- 数字のカード -->
            <UniformGrid Columns="3" Margin="-8,0,-8,16">
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="未完了のタスク" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="OpenTasksText" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="今日の作業時間" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TodayWorkText" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="これまでの作業時間" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TotalWorkText" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 今日のタスク -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="今日のタスク" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="NoTasksText" Text="今日やるタスクはありません。" Style="{StaticResource Muted}"
                                   Visibility="Collapsed" />
                        <ItemsControl x:Name="TaskList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="10"
                                            Background="{DynamicResource SubtleBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{Binding PriorityBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                            <ui:SymbolIcon Grid.Column="2" Symbol="Star24" Filled="True" FontSize="16"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           Visibility="{Binding FavoriteVisibility}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- データの場所 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="データの場所" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                        <TextBlock x:Name="DbPathText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="v6 と同じデータを使っています。"
                                   Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
