<UserControl x:Class="Seigetsu.Pages.TimerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="集中タイマー" Style="{StaticResource PageTitle}" />
            <TextBlock Text="計った時間は「分析」に記録されます" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                <!-- モードの切り替え -->
                <ListBox x:Name="ModeList" Style="{StaticResource SegmentedList}" Width="320"
                         SelectionChanged="OnModeChanged" Margin="0,0,0,22">
                    <ListBoxItem Content="ストップウォッチ" IsSelected="True" />
                    <ListBoxItem Content="ポモドーロ" />
                </ListBox>

                <TextBlock x:Name="PhaseText" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" />
                <TextBlock x:Name="TimeText" HorizontalAlignment="Center" FontSize="76" FontWeight="Bold"
                           FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,8" />
                <ProgressBar x:Name="Progress" Height="8" Maximum="1" Width="440" Margin="0,0,0,26"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SubtleBrush}"
                             BorderThickness="0" />

                <!-- 操作ボタン -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button x:Name="StartButton" Appearance="Primary" Width="170" Height="46" FontSize="16"
                               FontWeight="Bold" Margin="6,0" Click="OnStartClick" />
                    <ui:Button Content="リセット" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Width="130" Height="46"
                               Margin="6,0" Click="OnResetClick" />
                    <ui:Button x:Name="SkipButton" Content="次へ進む" Icon="{ui:SymbolIcon Next24}" Width="130" Height="46"
                               Margin="6,0" Click="OnSkipClick" />
                </StackPanel>

                <TextBlock x:Name="HintText" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,0" />

                <!-- 今日と直近 7 日間の合計 -->
                <UniformGrid Columns="2" Width="420" Margin="0,26,0,0">
                    <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="今日の集中" Style="{StaticResource Muted}" FontSize="12" />
                            <TextBlock x:Name="TodayText" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="直近7日間" Style="{StaticResource Muted}" FontSize="12" />
                            <TextBlock x:Name="WeekText" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
