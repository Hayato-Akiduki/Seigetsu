<Window x:Class="Seigetsu.FocusLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="霽月 - 集中ロック"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True"
        Background="#000000" FontFamily="{StaticResource AppFont}"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed" Deactivated="OnDeactivated">
    <!-- 集中タイマーが動いているあいだ、すべての画面を覆う。時計の大画面と同じく、黒と青で出す -->
    <Grid>
        <Border x:Name="BackgroundLayer" Visibility="Collapsed" />
        <Border x:Name="BackgroundShade" Background="#000000" Opacity="0.55" Visibility="Collapsed" />

        <!-- ほかの画面（2 台目のモニターなど）には、この一言だけ出す -->
        <TextBlock x:Name="SideText" Text="集中ロック中" FontSize="22" Foreground="#5A6070"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

        <!-- 時間と止めるボタンは、霽月の窓があった画面にだけ出す -->
        <Grid x:Name="ContentArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Viewbox Margin="80,60,80,20" MaxHeight="520">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="LockClosed24" Filled="True" FontSize="26" Foreground="#5B9BFF"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="集中ロック中" FontSize="26" Foreground="#A0A6B2" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" FontSize="30" Foreground="#5B9BFF" HorizontalAlignment="Center"
                               Margin="0,18,0,0" />
                    <TextBlock x:Name="TimeText" FontSize="180" FontWeight="Light" Foreground="#FFFFFF"
                               FontFamily="Segoe UI" Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Center" Margin="0,-6,0,0" />
                    <ProgressBar x:Name="Progress" Height="6" Maximum="1" Width="560" Margin="0,4,0,0"
                                 Foreground="#5B9BFF" Background="#262B36" BorderThickness="0" />
                </StackPanel>
            </Viewbox>

            <!-- 止めるボタン。うっかり押さないよう、長押ししたときだけ止まる -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,48">
                <Border x:Name="StopButton" Width="260" Height="52" CornerRadius="26" Background="#1A1F29"
                        BorderBrush="#3A4150" BorderThickness="1" Cursor="Hand" ClipToBounds="True"
                        PreviewMouseLeftButtonDown="OnStopDown" PreviewMouseLeftButtonUp="OnStopUp"
                        MouseLeave="OnStopLeave">
                    <Grid>
                        <!-- 押しているあいだ、左から色が満ちていく -->
                        <Border x:Name="StopFill" Background="#5B9BFF" Opacity="0.35" HorizontalAlignment="Left"
                                Width="0" CornerRadius="26" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Pause24" FontSize="20" Foreground="#FFFFFF" />
                            <TextBlock x:Name="StopLabel" Text="長押しで一時停止" FontSize="16" Foreground="#FFFFFF"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="3 秒押し続けるとタイマーを一時停止して、ロックを解きます" FontSize="13"
                           Foreground="#8E95A3" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
